<mvc:View controllerName="bookscapmfreestyleui5.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"   xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page2" title="Chapters">
    <core:Fragment fragmentName="bookscapmfreestyleui5.fragments.Header" type="XML"/>
<Link width="30px" />
<Link text="Home" press="_backHome" />
<Link width="30px" />
<Link text="Back" press="_backtoView1" />
<Link width="30px" />
<Link text="Cancel" press="_canceltohome" />

<List
    headerText="Chapters"
    headerLevel="H2"
    items="{
        path: 'chapters'
    }" >
    <StandardListItem
        title="{title}"
        counter="{pages}"/>
</List>
<core:Fragment fragmentName="bookscapmfreestyleui5.fragments.Footer" type="XML"/>
    </Page>
</mvc:View>